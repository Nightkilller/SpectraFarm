# =============================================================================
# AgriN — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- Google Gemini API (Phase 6) ---
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Earth Engine (Phase 2) ---
# Your Google Cloud project with Earth Engine API enabled.
# After creating the project, run:  earthengine authenticate
GEE_PROJECT=

# --- Google Cloud (optional) ---
GOOGLE_CLOUD_PROJECT=

# --- App Mode ---
# Set to "demo" to use mock data without external services.
# Set to "live" to use real satellite/AI services.
AGRIN_MODE=demo
